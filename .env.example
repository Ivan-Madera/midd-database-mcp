# ── Conexión (requerido) ──────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_user
DB_PASSWORD=your_password

# ── Base de datos por defecto (opcional) ──────────────────────────────
# Se usa cuando una tool no recibe el parámetro 'database'.
# Si se omite, las tools exigen que se indique 'database' explícitamente.
DB_NAME=your_database

# ── Allowlist de bases de datos (opcional) ────────────────────────────
# Lista separada por comas. Si está vacía o ausente, se permiten TODAS
# las BD a las que la cuenta tenga acceso.
# DB_ALLOWED_DATABASES=ventas,rrhh,MacropayPF

# ── TLS (opcional) ────────────────────────────────────────────────────
# DB_ENCRYPT: cifra la conexión (true por defecto).
# DB_TRUST_SERVER_CERTIFICATE: acepta certificados no verificados
#   (true por defecto; útil en dev, ponlo en false en producción con cert válido).
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=true

# ── Inactividad (opcional) ────────────────────────────────────────────
# Cierra los pools de conexión tras N milisegundos sin uso para liberar
# sesiones en el servidor. La siguiente llamada reconecta automáticamente.
# Default: 300000 (5 min). 0 = nunca cerrar por inactividad.
# DB_IDLE_TIMEOUT_MS=300000
